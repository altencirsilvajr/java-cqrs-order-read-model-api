{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:altencir:orders:OrderPlaced:v1",
  "title": "OrderPlaced.v1",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "orderId", "customerId", "itemCount", "total", "occurredAt"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"const": "OrderPlaced"},
    "schemaVersion": {"const": 1},
    "orderId": {"type": "string", "format": "uuid"},
    "customerId": {"type": "string", "minLength": 1},
    "itemCount": {"type": "integer", "minimum": 1},
    "total": {"type": "number", "minimum": 0},
    "occurredAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
